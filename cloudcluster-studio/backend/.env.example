# Generate a private value before deploying. The local dev server creates one automatically if unset.
CLOUDCLUSTER_JWT_SECRET=
CLOUDCLUSTER_ACCESS_MINUTES=10
CLOUDCLUSTER_REFRESH_DAYS=7

# Enable only when serving over HTTPS.
CLOUDCLUSTER_COOKIE_SECURE=false

# Comma-separated origins when the frontend is hosted separately.
CLOUDCLUSTER_CORS_ORIGINS=

# Optional; defaults to backend/data/cloudcluster.db.
# CLOUDCLUSTER_DATABASE_URL=sqlite:///./data/cloudcluster.db
